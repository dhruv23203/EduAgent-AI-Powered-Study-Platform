FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///./eduagent.db
AUTH_SECRET=change_this_long_random_secret

GOOGLE_CLIENT_ID=your_google_oauth_web_client_id

APP_TIMEZONE=Asia/Kolkata
APP_TIMEZONE_OFFSET_MINUTES=330

LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_API_KEY_2=optional_second_groq_api_key
# Or use one comma-separated list instead of numbered keys:
# GROQ_API_KEYS=groq_key_one,groq_key_two
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Unified across Free, Pro, and every future subscription plan.
AI_DAILY_REQUEST_BUDGET=100
# LLM_DAILY_LIMIT is deprecated and used only when the unified setting is absent.
LLM_CACHE_ENABLED=true
AI_DEMO_MODE=false
AI_ALLOW_LOCAL_FALLBACK=true
QUIZ_ALLOW_LOCAL_FALLBACK=true
AI_PROGRESS_INSIGHTS_ENABLED=true
MAX_STUDY_PLAN_DAYS=365
VECTOR_MEMORY_ENABLED=true
VECTOR_MEMORY_DIMENSIONS=384
